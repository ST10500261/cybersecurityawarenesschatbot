<Window x:Class="PROGRAMMING_PART_2_CHATBOT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Shield"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="800"
        Background="#F0F7FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TopicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12365A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12B8B0"/>
            <Setter Property="Foreground" Value="#12365A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#12365A"
                Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cyber Shield"
                           Foreground="#12D8D0"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="Cybersecurity Awareness Chatbot"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Topic list -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,12,0">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Cybersecurity Topics"
                               Foreground="#12365A"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Content="Multi-Factor Authentication" Tag="Multi-Factor Authentication" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Social Engineering" Tag="Social Engineering" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Malware" Tag="Malware" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Ransomware" Tag="Ransomware" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Public Wi-Fi" Tag="Public Wi-Fi" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Privacy" Tag="Privacy" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Social Media" Tag="Social Media" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Online Scams" Tag="Online Scams" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Software Updates" Tag="Software Updates" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Safe Downloading" Tag="Safe Downloading" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Email Security" Tag="Email Security" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Device Security" Tag="Device Security" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Backups" Tag="Backups" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                            <Button Content="Identity Theft" Tag="Identity Theft" Style="{StaticResource TopicButtonStyle}" Click="TopicButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Chat area -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ChatMessages"
                             Grid.Row="0"
                             Background="#F0F7FA"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BubbleColor}"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="4"
                                        MaxWidth="480"
                                        HorizontalAlignment="{Binding Alignment}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}"
                                                   Foreground="{Binding SenderColor}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Input and action buttons -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="MessageInput"
                                 Grid.Row="0"
                                 MinHeight="42"
                                 Padding="10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#12B8B0"
                                 BorderThickness="1"
                                 KeyDown="MessageInput_KeyDown"
                                 ToolTip="Type your message here"/>

                        <WrapPanel Grid.Row="1"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0">

                            <Button Content="Send"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="SendButton_Click"
                                    Margin="0,0,8,8"/>

                            <Button Content="Chat History"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="HistoryButton_Click"
                                    Margin="0,0,8,8"/>

                            <Button Content="Clear Chat"
                                    Background="#12365A"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Padding="14,9"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ClearButton_Click"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
